# Phlix Mobile Environment Configuration
# Copy this file to .env and update values as needed

# Build-time API base URL for self-hosted deployments
# This is read at build time by react-native-config
# Runtime override can be set from the login screen's server field (persisted in
# settings, shown read-only under Settings)
PHLIX_BASE_URL=https://api.phlix.app

# Direct-mode SyncPlay WebSocket port (build time, react-native-config).
# Omit for the server default (8097). Malformed values fall back to the
# default.
PHLIX_SYNCPLAY_WS_PORT=8097

# Hub relay SyncPlay WebSocket port (build time, react-native-config).
# Omit for the hub default (8804). Malformed values fall back to the default.
PHLIX_HUB_RELAY_PORT=8804
