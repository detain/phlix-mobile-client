# Phlix Mobile Environment Configuration
# Copy this file to .env and update values as needed

# Build-time API base URL for self-hosted deployments
# This is read at build time by react-native-config
# Runtime override can be set via the Settings screen (serverUrl field)
PHLIX_BASE_URL=https://api.phlix.app

# Direct-mode SyncPlay WebSocket port (build time, react-native-config).
# Omit for the server default (8097). Malformed values fall back to the
# default. Note: the hub RELAY port (8804) is a compiled constant with no
# env override.
PHLIX_SYNCPLAY_WS_PORT=8097
