<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- M-MOBILE-06 (MAJORS queue; review mobile__crossfe M3): Android 13+
         will not let notifee.requestPermission() grant at all unless
         POST_NOTIFICATIONS is declared; at targetSdk 36 omitting it meant
         every locally-displayed notification (download-complete lane)
         silently never appeared on Android. fs-pinned by
         src/__tests__/androidPermissions.gate.test.ts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- M-MOBILE-13 (review mobile__crossfe): the legacy READ/WRITE_EXTERNAL_STORAGE
         pair is retired. Nothing in this app reads or writes shared storage
         through the deprecated APIs — zero MediaStore/Environment usage in
         android/ and src/ (grep-verified), downloads land in app-private
         dirs — so the pair only inflated the install-time permission
         prompt.
         MW-013 (review mobile__crossfe): the granular READ_MEDIA_* trio that
         M-MOBILE-13 left in "as the review directs" is retired by the SAME
         premise that paragraph already states — the trio is equally unused
         (zero MediaStore/Environment references in android/ or src/, and
         zero PermissionsAndroid calls anywhere in src/, so on API 33+ it was
         never even requested at runtime). A declared-but-never-used media
         permission only surfaces in the Play Store permission disclosure for
         functionality this app does not have. If gallery access is ever
         built, the declaration AND the request AND the consumer land in that
         one change. The absence of all four media permissions is fs-pinned
         by src/__tests__/androidPermissions.gate.test.ts. -->

    <!-- Cleartext HTTP is deliberate: Phlix is a self-hosted client that talks
         to user-typed LAN servers (http://192.168.x.x:8096), which Android
         blocks by default since API 28. The server set is arbitrary private
         addresses, so a domain-specific network_security_config allowlist is
         not expressible. The RN layer defaults scheme-less input to https
         (LoginScreen); cleartext stays a LAN-only tradeoff, not the path of
         first resort. [review M-MOBILE-12] -->
    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- M-MOBILE-17 (review mobile__gameux M-F): external entry.
                 Registers the SAME `phlix://` scheme the windows client
                 already owns (deepLinkValidator.ts), so links like
                 phlix://media/{id} / phlix://play/{id} open this app. Route
                 mapping lives in src/navigation/linking.ts (existing routes
                 only); MainActivity is launchMode="singleTask", so warm
                 links arrive as react-navigation's `url` event. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="phlix" />
            </intent-filter>
        </activity>
    </application>
</manifest>
