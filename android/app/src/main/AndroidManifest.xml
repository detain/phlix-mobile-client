<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- M-MOBILE-06 (MAJORS queue; review mobile__crossfe M3): Android 13+
         will not let notifee.requestPermission() grant at all unless
         POST_NOTIFICATIONS is declared; at targetSdk 36 omitting it meant
         every locally-displayed notification (download-complete lane)
         silently never appeared on Android. fs-pinned by
         src/__tests__/androidPermissions.gate.test.ts. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- M-MOBILE-13 (review mobile__crossfe): the legacy READ/WRITE_EXTERNAL_STORAGE
         pair is retired. Nothing in this app reads or writes shared storage
         through the deprecated APIs — zero MediaStore/Environment usage in
         android/ and src/ (grep-verified), downloads land in app-private
         dirs — so the pair only inflated the install-time permission
         prompt. The granular READ_MEDIA_* trio below stays for API 33+,
         exactly as the review's cure advice directs. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />

    <!-- Cleartext HTTP is deliberate: Phlix is a self-hosted client that talks
         to user-typed LAN servers (http://192.168.x.x:8096), which Android
         blocks by default since API 28. The server set is arbitrary private
         addresses, so a domain-specific network_security_config allowlist is
         not expressible. The RN layer defaults scheme-less input to https
         (LoginScreen); cleartext stays a LAN-only tradeoff, not the path of
         first resort. [review M-MOBILE-12] -->
    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="false"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- M-MOBILE-17 (review mobile__gameux M-F): external entry.
                 Registers the SAME `phlix://` scheme the windows client
                 already owns (deepLinkValidator.ts), so links like
                 phlix://media/{id} / phlix://play/{id} open this app. Route
                 mapping lives in src/navigation/linking.ts (existing routes
                 only); MainActivity is launchMode="singleTask", so warm
                 links arrive as react-navigation's `url` event. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="phlix" />
            </intent-filter>
        </activity>
    </application>
</manifest>
