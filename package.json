{
  "name": "phlix-mobile",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "A cross-platform mobile application for media playback",
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "start": "react-native start",
    "test": "jest --runInBand",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "typecheck": "tsc --noEmit",
    "copyright": "node scripts/add-copyright.mjs",
    "check:podfile-lock": "node scripts/check-podfile-lock.mjs",
    "audit:gate": "node scripts/audit-gate.mjs",
    "build:android:debug": "cd android && ./gradlew assembleDebug",
    "build:android:release": "cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@notifee/react-native": "^9.1.8",
    "@phlix/contracts": "github:detain/phlix-contracts#v0.5.8",
    "@phlix/syncplay": "github:detain/phlix-syncplay#v0.1.8",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/cli-platform-android": "^21.0.0",
    "@react-native-community/cli-server-api": "^21.0.0",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-vector-icons/common": "^14.0.0",
    "@react-native-vector-icons/material-icons": "^14.0.0",
    "@react-navigation/bottom-tabs": "^7.18.3",
    "@react-navigation/native": "^7.3.4",
    "@react-navigation/native-stack": "^7.17.6",
    "axios": "^1.21.1",
    "react": "^19.3.1",
    "react-native": "^0.88.1",
    "react-native-config": "^1.6.1",
    "react-native-gesture-handler": "^3.0.2",
    "react-native-keychain": "^11.0.0",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-reanimated": "^4.7.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.25.2",
    "react-native-worklets": "^0.13.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "@babel/runtime": "^7.29.14",
    "@react-native-community/cli": "^21.0.0",
    "@react-native-community/cli-platform-ios": "^21.0.0",
    "@react-native/babel-preset": "^0.88.1",
    "@react-native/eslint-config": "^0.88.1",
    "@react-native/jest-preset": "^0.88.1",
    "@react-native/metro-config": "^0.88.1",
    "@react-native/typescript-config": "^0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.1.1",
    "babel-jest": "^30.5.2",
    "eslint": "^8.57.0",
    "eslint-plugin-ft-flow": "^3.0.11",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "glob": "^14.0.5",
    "rimraf": "^6.1.3",
    "compression": "^1.8.2",
    "shell-quote": "^1.11.0"
  },
  "engines": {
    "node": ">=24"
  }
