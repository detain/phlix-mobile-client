<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Phlix</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- M-MOBILE-17 (review mobile__gameux M-F): external entry. Registers the
	     SAME phlix:// scheme the windows client already owns, so
	     phlix://media/{id} / phlix://play/{id} open this app. Route mapping
	     lives in src/navigation/linking.ts (existing routes only). -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.phlixmobile.PhlixMobile</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>phlix</string>
			</array>
		</dict>
	</array>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- Arbitrary loads are deliberate: Phlix is a self-hosted client that
	     talks to user-typed LAN servers over plain http (e.g.
	     http://192.168.x.x:8096). Those targets are arbitrary private
	     addresses, so per-domain ATS exceptions are not expressible. The RN
	     layer defaults scheme-less input to https (LoginScreen); this is the
	     documented LAN tradeoff, same law as Android's usesCleartextTraffic.
	     NSAllowsArbitraryLoads already subsumes local networking, so no
	     separate NSAllowsLocalNetworking key is needed. [review M-MOBILE-12] -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string></string>
	<!-- M-MOBILE-02: 'audio' is what lets AVPlayer keep playing when the
	     app backgrounds / the phone locks. It only works paired with the
	     .playback AVAudioSession category set in PhlixPlayerView.swift —
	     the mode alone silences on background. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
